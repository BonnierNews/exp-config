{
  "name": "exp-config",
  "description": "Simple configuration management",
  "version": "5.0.0",
  "type": "module",
  "author": "Bonnier News",
  "contributors": [
    "Gabriel Falkenberg <gabriel.falkenberg@gmail.com>",
    "Jens Carlén",
    "Joel Abrahamsson <mail@joelabrahamsson.com>",
    "William Sköld <william.skold@gmail.com>",
    "Pål Edman",
    "generika@bonniernews.se"
  ],
  "scripts": {
    "build": "tsx ./scripts/build.ts",
    "test:cjs": "mocha --reporter spec ./test/test.cjs",
    "test": " npm run build && npm run test:cjs && tsx ./test/mocha.ts && eslint . --cache"
  },
  "repository": "git://github.com/BonnierNews/exp-config.git",
  "keywords": [
    "configuration"
  ],
  "license": "MIT",
  "dependencies": {
    "deepmerge-ts": "^7.1.5",
    "dotenv": "^17.2.1"
  },
  "devDependencies": {
    "@bonniernews/eslint-config": "^2.0.2",
    "@bonniernews/tsconfig": "^0.0.2",
    "@types/chai": "^4.3.14",
    "@types/eslint": "^9.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.10",
    "chai": "^5.2.1",
    "esbuild": "^0.25.6",
    "eslint": "^9.33.0",
    "eslint-plugin-filename-rules": "^1.3.1",
    "mocha": "^9.2.0",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "exports": {
    "./*.js": {
      "types": "./dist/*.d.ts",
      "import": "./dist/*.js",
      "require": "./dist/*.cjs"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json",
    "CHANGELOG.md"
  ]
}
