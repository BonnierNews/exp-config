{
  "name": "exp-config",
  "description": "Simple configuration management",
  "version": "5.0.0-beta",
  "type": "module",
  "author": "Bonnier News",
  "contributors": [
    "Gabriel Falkenberg <gabriel.falkenberg@gmail.com>",
    "Jens Carlén",
    "Joel Abrahamsson <mail@joelabrahamsson.com>",
    "William Sköld <william.skold@gmail.com>",
    "Pål Edman",
    "generika@bonniernews.se"
  ],
  "scripts": {
    "build": "tsx ./scripts/build.ts",
    "lint": "eslint . --cache",
    "prepack": "npm run build",
    "pretest": "npm run build",
    "test:cjs": "mocha --bail ./test/test.cjs",
    "test:esm": "tsx ./test/mocha.ts",
    "test": "npm run lint && npm run typecheck && npm run test:cjs && npm run test:esm",
    "typecheck": "tsc --noemit"
  },
  "license": "MIT",
  "dependencies": {
    "deepmerge-ts": "^7.1.5",
    "dotenv": "^17.2.1"
  },
  "devDependencies": {
    "@bonniernews/eslint-config": "^2.0.2",
    "@bonniernews/tsconfig": "^0.0.2",
    "@types/chai": "^4.3.14",
    "@types/eslint": "^9.6.1",
    "@types/mocha": "^10.0.10",
    "@types/node": "^24.0.10",
    "chai": "^4.5.0",
    "esbuild": "^0.25.6",
    "eslint": "^9.33.0",
    "eslint-plugin-filename-rules": "^1.3.1",
    "globals": "^16.3.0",
    "mocha": "^11.7.1",
    "tsx": "^4.20.3",
    "typescript": "^5.8.3"
  },
  "peerDependencies": {
    "typescript": "^5.0.0"
  },
  "peerDependenciesMeta": {
    "typescript": {
      "optional": true
    }
  },
  "exports": {
    "./*": {
      "types": "./dist/*.d.ts",
      "require": "./dist/*.cjs",
      "import": "./dist/*.js"
    }
  },
  "files": [
    "dist",
    "LICENSE",
    "README.md",
    "package.json",
    "CHANGELOG.md"
  ]
}
